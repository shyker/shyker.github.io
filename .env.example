# Public frontend build-time setting
NEXT_PUBLIC_CONTENT_API_URL=https://api.example.com

# Spring Boot runtime settings (set these on the server, never commit real values)
BLOG_DB_PATH=/var/lib/shyler-blog/blog.db
BLOG_MEDIA_DIR=/var/lib/shyler-blog/media
BLOG_MEDIA_BASE_URL=https://api.example.com/media
BLOG_SEED_DIR=/opt/shyler-blog/src/posts
BLOG_CORS_ORIGINS=https://shyker.github.io,http://localhost:3000
ADMIN_PASSWORD_HASH=$2a$10$replace_with_a_bcrypt_hash
ADMIN_JWT_SECRET=replace-with-at-least-32-random-bytes
DIARY_PASSWORD=replace-existing-diary-password
